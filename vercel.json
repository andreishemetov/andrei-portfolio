{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ashemetau.vercel.app"
        }
      ],
      "destination": "https://shemetau.eu/:path*",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/career",
      "statusCode": 301
    },
    {
      "source": "/experience/",
      "destination": "/career",
      "statusCode": 301
    }
  ]
}
