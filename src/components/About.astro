---
import type { ProfileBlock } from '../lib/profile';

interface Props {
  blocks: ProfileBlock[];
}

const { blocks } = Astro.props;

const title = blocks.find(
  (block) => block.type === 'heading_2'
)?.text ?? '';

const paragraphs = blocks.filter(
  (block) => block.type === 'paragraph'
);
---

<section class="about">
  <h2>{title}</h2>

  <div class="about-content">
    {paragraphs.map((paragraph) => (
      <p>{paragraph.text}</p>
    ))}
  </div>
</section>

<style>
  .about {
    margin-top: 5rem;
    padding-top: 0;
  }

  .about h2 {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .about-content {
    max-width: 760px;
  }

  .about-content p {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.75;
  }
</style>