---
import type { ProfileBlock } from '../lib/profile';

interface Props {
  blocks: ProfileBlock[];
}

const { blocks } = Astro.props;

const title = blocks.find(
  (block) => block.type === 'heading_2'
)?.text ?? '';

const intro = blocks.find(
  (block) => block.type === 'paragraph'
)?.text ?? '';

const items = blocks
  .map((block, index) => {
    if (block.type !== 'heading_3') {
      return null;
    }

    const description = blocks
      .slice(index + 1)
      .find((item) => item.type === 'paragraph');

    return {
      title: block.text,
      description: description?.text ?? '',
    };
  })
  .filter(Boolean);
---

<section class="principles">

  <header class="principles-header">
    <h2>{title}</h2>
    <p>{intro}</p>
  </header>

  <div class="principles-grid">
    {items.map((item, index) => (
      <article class="principle">
        <span class="principle-number">
          {String(index + 1).padStart(2, '0')}
        </span>

        <h3>{item?.title}</h3>
        <p>{item?.description}</p>
      </article>
    ))}
  </div>

</section>

<style>
  .principles {
    margin-top: 8rem;
  }

  .principles-header {
    max-width: 760px;
    margin-bottom: 3.5rem;
  }

  .principles-header h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .principles-header p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.75;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .principle {
    padding: 1.75rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .principle-number {
    display: block;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    opacity: 0.5;
  }

  .principle h3 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .principle p {
    margin: 0;
    line-height: 1.7;
    opacity: 0.75;
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4rem;
    }
  }
</style>