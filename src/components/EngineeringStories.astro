---
interface Story {
  id: string;
  title: string;
  slug: string;
  description: string;
}

interface Props {
  stories: Story[];
}

const { stories } = Astro.props;
---

<section class="stories">

  <header class="stories-header">
    <p class="eyebrow">ENGINEERING STORIES</p>
    <h2>Problems I've worked through</h2>
  </header>

  <div class="stories-grid">
    {stories.map((story, index) => (
      <a
        class="story-card"
        href={`/stories/${story.slug}`}
      >
        <span class="story-number">
          {String(index + 1).padStart(2, '0')}
        </span>

        <h3>{story.title}</h3>

        <p>{story.description}</p>

        <span class="story-link">
          Read story →
        </span>
      </a>
    ))}
  </div>

</section>

<style>
    .stories {
      margin-top: 8rem;
    }
  
    .stories-header {
      margin-bottom: 3.5rem;
    }
  
    .stories-header .eyebrow {
      margin: 0 0 1rem;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      opacity: 0.6;
    }
  
    .stories-header h2 {
      margin: 0;
      max-width: 760px;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1;
    }
  
    .stories-grid {
      display: grid;
      grid-template-columns: 1fr;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  
    .story-card {
      display: flex;
      flex-direction: column;
      padding: 2rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
      color: inherit;
      text-decoration: none;
    }
  
    .story-number {
      margin-bottom: 2rem;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      opacity: 0.5;
    }
  
    .story-card h3 {
      margin: 0 0 1rem;
      font-size: 1.35rem;
      line-height: 1.3;
    }
  
    .story-card p {
      margin: 0 0 2rem;
      line-height: 1.7;
      opacity: 0.75;
    }
  
    .story-link {
      margin-top: auto;
      font-weight: 600;
    }
  
    @media (min-width: 768px) {
      .stories-grid {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 4rem;
      }
    }
  </style>