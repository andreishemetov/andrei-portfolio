---
import type { ProfileBlock } from '../lib/profile';

interface Props {
  blocks: ProfileBlock[];
}

const { blocks } = Astro.props;
---

<div class="notion-content">
  {
    blocks.map((block) => {
      switch (block.type) {
        case 'heading_2':
          return <h2>{block.text}</h2>;

        case 'heading_3':
          return <h3>{block.text}</h3>;

        case 'paragraph':
          return <p>{block.text}</p>;

        default:
          return null;
      }
    })
  }
</div>