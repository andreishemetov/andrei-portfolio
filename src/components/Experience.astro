---
import type { ProfileBlock } from '../lib/profile';

interface Props {
  blocks: ProfileBlock[];
}

const { blocks } = Astro.props;

const title = blocks.find(
  (block) => block.type === 'heading_2'
)?.text ?? '';

const paragraphs = blocks.filter(
  (block) => block.type === 'paragraph'
);

const intro = paragraphs[0]?.text ?? '';

const experienceBlocks = paragraphs.slice(1);

const items = [];

for (let i = 0; i < experienceBlocks.length; i += 3) {
  items.push({
    meta: experienceBlocks[i]?.text ?? '',
    role: experienceBlocks[i + 1]?.text ?? '',
    description: experienceBlocks[i + 2]?.text ?? '',
  });
}
---

<section class="experience">
  <header class="experience-header">
    <h2>{title}</h2>
    <p>{intro}</p>
  </header>

  <div class="experience-list">
    {items.map((item) => (
      <article class="experience-item">
        <div class="experience-meta">
          {item.meta}
        </div>

        <div class="experience-content">
          <h3>{item.role}</h3>
          <p>{item.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
    .experience {
      margin-top: 8rem;
    }
  
    .experience-header {
      max-width: 760px;
      margin-bottom: 3.5rem;
    }
  
    .experience-header h2 {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1;
    }
  
    .experience-header p {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.7;
      opacity: 0.75;
    }
  
    .experience-list {
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  
    .experience-item {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }
  
    .experience-meta {
      font-size: 0.85rem;
      line-height: 1.5;
      opacity: 0.55;
    }
  
    .experience-content h3 {
      margin: 0 0 0.75rem;
      font-size: 1.25rem;
      line-height: 1.3;
    }
  
    .experience-content p {
      max-width: 720px;
      margin: 0;
      line-height: 1.7;
      opacity: 0.75;
    }
  
    @media (min-width: 768px) {
      .experience-item {
        grid-template-columns: minmax(220px, 0.7fr) 2fr;
        gap: 4rem;
        padding: 2.5rem 0;
      }
    }
  </style>