---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfileItems } from '../lib/profile';
import NotionContent from '../components/NotionContent.astro';
import WhatIDo from '../components/WhatIDo.astro';
import Principles from '../components/Principles.astro';
import EngineeringStories from '../components/EngineeringStories.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import ContactCTA from '../components/ContactCTA.astro';

const profileItems = await getProfileItems();

const hero = profileItems.find(
  (item) => item.section === 'Hero'
);

const heroBlocks = hero?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const whatIDo = profileItems.find(
  (item) => item.section === 'What I Do'
);

const whatIDoBlocks = whatIDo?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const principles = profileItems.find(
  (item) => item.section === 'Principles'
);

const principlesBlocks = principles?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const stories = profileItems.filter(
  (item) => item.section === 'Stories'
);

const storyCards = stories.map((story) => {
  const paragraphs = story.blocks.filter(
    (block) =>
      block.type === 'paragraph' &&
      block.text.trim().length > 0 &&
      block.text !== 'Starting point'
  );

  return {
    id: story.id,
    title: story.name,
    slug: story.slug,
    description: paragraphs[0]?.text ?? '',
  };
});

const experience = profileItems.find(
  (item) => item.section === 'Experience'
);

const experienceBlocks = experience?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const about = profileItems.find(
  (item) => item.section === 'About'
);

const aboutBlocks = about?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const cta = profileItems.find(
  (item) => item.section === 'CTA'
);

const ctaBlocks = cta?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Andrei Shemetau',
    url: new URL('/', Astro.site).href,
    jobTitle: 'Mobile Team Lead & Software Engineer',
    sameAs: [
      'https://www.linkedin.com/in/andrei-shemetau',
    ],
    knowsAbout: [
      'Mobile Software Engineering',
      'Flutter',
      'iOS Development',
      'Mobile Architecture',
      'Engineering Leadership',
    ],
  },
};

---

<BaseLayout>
  <script
  type="application/ld+json"
  set:html={JSON.stringify(profileJsonLd)}
/>

  <!---------------------------------- HERO ----------------------------------->
  <section class="hero">
    <p class="eyebrow">
      {heroBlocks[0]?.text}
    </p>
  
    <h1>
      {heroBlocks[1]?.text}
    </h1>
  
    <p class="hero-description">
      {heroBlocks[2]?.text}
    </p>
  
    <p class="hero-description">
      {heroBlocks[3]?.text}
    </p>
  
    <div class="hero-actions">
      <a class="primary-button" href="/projects">
        Explore my work →
      </a>
  
      <!--
      <a
        class="secondary-button"
        href="/cv/andrei-shemetau-cv.pdf"
        target="_blank"
      >
        Download CV
      </a>
      -->
  
      <a
        class="secondary-button"
        href="https://www.linkedin.com/in/andrei-shemetau"
        target="_blank"
      >
        LinkedIn
      </a>
    </div>
  
  </section>


  <section class="stats">

    <div>
      <strong>13+</strong>
      <span>Years in mobile engineering</span>
    </div>

    <div>
      <strong>Flutter & iOS</strong>
      <span>Primary platforms</span>
    </div>

    <div>
      <strong>Lead</strong>
      <span>Architecture & engineering</span>
    </div>

  </section>

  <!---------------------------------- WHAT I DO ----------------------------------->
  {whatIDo && (
    <WhatIDo blocks={whatIDoBlocks} />
  )}

  <!---------------------------------- PRINCIPLES ----------------------------------->
  {principles && (
    <Principles blocks={principlesBlocks} />
  )}

  <!---------------------------------- STORIES ----------------------------------->
  <EngineeringStories stories={storyCards} />

  <!---------------------------------- EXPERIENCE ----------------------------------->
  {experience && (
    <Experience blocks={experienceBlocks} />
  )}

  <!---------------------------------- ABOUT ----------------------------------->
  {about && (
    <About blocks={aboutBlocks} />
  )}
  
  <!---------------------------------- CTA ----------------------------------->
  {cta && (
    <ContactCTA blocks={ctaBlocks} />
  )}

</BaseLayout>