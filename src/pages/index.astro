---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfileItems } from '../lib/profile';
import MyFocus from '../components/MyFocus.astro';
import ContactCTA from '../components/ContactCTA.astro';

const profileItems = await getProfileItems();

const hero = profileItems.find(
  (item) => item.section === 'Hero'
);

const heroBlocks = hero?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const myFocus = profileItems.find(
  (item) => item.section === 'MyFocus'
);

const myFocusBlocks = myFocus?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const cta = profileItems.find(
  (item) => item.section === 'CTA'
);

const ctaBlocks = cta?.blocks.filter(
  (block) => block.text.trim().length > 0
) ?? [];

const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Andrei Shemetau',
    url: new URL('/', Astro.site).href,
    jobTitle: 'Mobile Team Lead & Software Engineer',
    sameAs: [
      'https://www.linkedin.com/in/andrei-shemetau',
    ],
    knowsAbout: [
      'Mobile Software Engineering',
      'Flutter',
      'iOS Development',
      'Mobile Architecture',
      'Engineering Leadership',
    ],
  },
};

---

<BaseLayout>
  <script
  type="application/ld+json"
  set:html={JSON.stringify(profileJsonLd)}
/>

  <!---------------------------------- HERO ----------------------------------->
  <section class="hero">  
    <h1>
      {heroBlocks[0]?.text}
    </h1>
  
    <p class="hero-description">
      {heroBlocks[1]?.text}
    </p>
  
    <p class="hero-description">
      {heroBlocks[2]?.text}
    </p>
  
  </section>


  <section class="stats">

    <div>
      <strong>14+</strong>
      <span>Years in mobile engineering</span>
    </div>

    <div>
      <strong>Flutter & iOS</strong>
      <span>Primary platforms</span>
    </div>

    <div>
      <strong>Lead</strong>
      <span>Architecture & engineering</span>
    </div>

  </section>

  <!---------------------------------- MY FOCUS ----------------------------------->
  {myFocus && (
    <MyFocus blocks={myFocusBlocks} />
  )}
  
  <!---------------------------------- CTA ----------------------------------->
  {cta && (
    <ContactCTA blocks={ctaBlocks} />
  )}

</BaseLayout>