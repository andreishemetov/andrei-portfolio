---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageBlocks } from "../lib/notion";
import { renderBlocks } from "../lib/notion-renderer";

const pageId =
  import.meta.env.NOTION_PRIVACY_PAGE_ID ??
  "40bad328-30f1-8137-8e47-e04d24dfd86c";

const blocks = await getPageBlocks(pageId);
const html = renderBlocks(blocks);
---

<BaseLayout
  title="Privacy Policy | Andrei Shemetau"
  description="Privacy information for the Andrei Shemetau portfolio website."
>
  <article class="legal-page">
    <header>
      <p class="eyebrow">PRIVACY</p>
      <h1>Privacy Policy</h1>
    </header>

    <div class="content" set:html={html} />
  </article>
</BaseLayout>

<style>
  .legal-page {
    max-width: var(--article-width);
  }

  .legal-page header {
    margin-bottom: 48px;
  }

  .legal-page h1 {
    font-size: clamp(42px, 7vw, 68px);
  }

  .legal-page .content a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
