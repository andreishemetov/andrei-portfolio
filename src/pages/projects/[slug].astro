---
import BaseLayout from '../../layouts/BaseLayout.astro';

import { getProjects } from '../../lib/projects';
import { getPageBlocks } from '../../lib/notion';
import { renderBlocks } from '../../lib/notion-renderer';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },

    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const blocks = await getPageBlocks(project.id);
const html = renderBlocks(blocks);

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: `${project.name} case study by Andrei Shemetau`,
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
  ...(project.cover && { image: project.cover }),
  ...(project.technologies.length > 0 && {
    keywords: project.technologies.join(', '),
  }),
  author: {
    '@type': 'Person',
    name: 'Andrei Shemetau',
    url: new URL('/', Astro.site ?? Astro.url).href,
  },
};
---

<BaseLayout
  title={`${project.name} — Andrei Shemetau`}
  description={`${project.name} case study by Andrei Shemetau`}
  image={project.cover || undefined}
  structuredData={projectJsonLd}
>

  <article>

    <a href="/projects">
      ← Projects
    </a>

    <header>
      <h1>{project.name}</h1>

      <p>
        {project.role}
        {project.domain ? ` · ${project.domain}` : ''}
      </p>

      <div class="technology-list">
        {project.technologies.map((technology) => (
          <span>{technology}</span>
        ))}
      </div>
    </header>

    {project.cover && (
      <div class="project-cover">
        <img
          src={project.cover}
          alt={`${project.name} project`}
          loading="eager"
        />
      </div>
    )}

    <div
      class="content"
      set:html={html}
    />

  </article>

</BaseLayout>
